{
  "name": "desktop-calendar",
  "version": "1.3.0",
  "description": "바탕화면 캘린더",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable zip"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.ilsang.desktopcalendar",
    "productName": "바탕화면 캘린더",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "icon.png",
      "tray.png"
    ],
    "win": {
      "artifactName": "DesktopCalendar.${ext}",
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "DesktopCalendar.exe"
    }
  },
  "dependencies": {
    "koffi": "^2.9.0"
  }
}